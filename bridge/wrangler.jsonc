{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brijeshb42-claude-triage-sandbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "secrets": {
    "required": ["SANDBOX_API_KEY"],
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 2,
    },
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "Sandbox", "name": "Sandbox" },
      { "class_name": "WarmPool", "name": "WarmPool" },
    ],
  },
  "migrations": [
    { "new_sqlite_classes": ["Sandbox"], "tag": "v1" },
    { "new_sqlite_classes": ["WarmPool"], "tag": "v2" },
  ],
  "triggers": {
    "crons": ["* * * * *"],
  },
  "vars": {
    "SANDBOX_PROVIDER": "cloudflare",
    "SANDBOX_TRANSPORT": "rpc",
    "WARM_POOL_TARGET": "0",
    "WARM_POOL_REFRESH_INTERVAL": "10000",
    "WARM_POOL_MAX_INSTANCES": "2",
    "WARM_POOL_SCALE_BATCH_SIZE": "2",
  },
  "preview_urls": false,
}
